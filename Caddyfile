# Replace with your actual domain or Hetzner VPS IP
{$DOMAIN:localhost} {
    # API gateway — FastAPI routes are defined WITH the /api prefix,
    # so the prefix must be passed through untouched (no strip_prefix).
    # flush_interval -1 keeps SSE streaming live (/api/chat/stream).
    handle /api/* {
        reverse_proxy indy-gateway:8642 {
            flush_interval -1
        }
    }

    # Gateway health probe
    handle /health {
        reverse_proxy indy-gateway:8642
    }

    # Web UI Dashboard (SPA fallback)
    handle {
        reverse_proxy indy-web:3000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format console
    }
}
