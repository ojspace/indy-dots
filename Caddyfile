# Replace with your actual domain or Hetzner VPS IP
{$DOMAIN:localhost} {
    # API gateway — FastAPI routes are defined WITH the /api prefix,
    # so the prefix must be passed through untouched (no strip_prefix).
    # flush_interval -1 keeps SSE streaming live (/api/chat/stream).
    handle /api/* {
        reverse_proxy indy-gateway:8642 {
            flush_interval -1
        }
    }

    # Gateway health probe
    handle /health {
        reverse_proxy indy-gateway:8642
    }

    # Web UI Dashboard (SPA fallback)
    handle {
        reverse_proxy indy-web:3000
    }

    # Compress responses.
    encode gzip

    # Security headers. HSTS `preload` is intentionally OFF by default:
    # only append `; preload` once {$DOMAIN} is a real production domain
    # you control (preloading localhost/IPs breaks local access and is
    # hard to undo).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # SPA: scripts stay 'self'; 'unsafe-inline' allowed for styles only
        # (bundled CSS); frame-ancestors 'none' blocks clickjacking.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    log {
        output stdout
        format console
    }
}
