# ==============================================================================
# Indy-Dots Environment Configuration — copy to .env and fill in
# ==============================================================================

# Server & Security
ENVIRONMENT=production
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8642
WEB_PORT=3000
AUTH_TOKEN=change-me-to-a-secure-random-token-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistent Data Storage Path on Host
DATA_DIR=/opt/data
OBSIDIAN_VAULT_DIR=/opt/data/vault

# Primary Intelligence Model (Chief of Staff / High Reasoning)
# Supports: openrouter, anthropic, openai, nebius, groq, deepseek, ollama
PRIMARY_MODEL_PROVIDER=openrouter
PRIMARY_MODEL=anthropic/claude-3.7-sonnet
PRIMARY_MODEL_API_KEY=your_primary_api_key_here
PRIMARY_MODEL_BASE_URL=https://openrouter.ai/api/v1

# Worker Fleet Model (Lean / Free Tier for Sub-Agents: Researcher, Writer, SEO, Ops)
WORKER_MODEL_PROVIDER=openrouter
WORKER_MODEL=deepseek/deepseek-chat
WORKER_MODEL_API_KEY=your_worker_api_key_here
WORKER_MODEL_BASE_URL=https://openrouter.ai/api/v1

# Smart Fallback Model
FALLBACK_MODEL_PROVIDER=openrouter
FALLBACK_MODEL=deepseek/deepseek-v4-flash
FALLBACK_MODEL_API_KEY=your_fallback_api_key_here

# Token & Loop Discipline
MAX_TURNS_PER_TASK=20
VERIFICATION_GATE_MAX_PASSES=1
TOKEN_COMPRESSION_ENABLED=true
TOKEN_COMPRESSION_THRESHOLD=0.5

# Telegram Companion (Mobile Access Layer)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Governed Approvals & Gate Engine
# APPROVALS_MODE: manual | strict | auto_safe
APPROVALS_MODE=manual
APPROVAL_TIMEOUT_SECONDS=300
TIRITH_SECURITY_GATE=true

# Native Self-Hosted MCP Services
MCP_LINEAR_API_KEY=
MCP_GOOGLE_WORKSPACE_CREDENTIALS=/opt/data/google/sa-key.json
MCP_SEARCH_API_KEY=
MCP_BROWSER_HEADLESS=true

# Governed Connectors (P1)
# GitHub REST connector: list_issues (read, auto-approved) vs create_issue (write, pauses).
GITHUB_TOKEN=
GITHUB_REPO=
# Generic MCP dispatcher allowlist (comma-separated server names). Empty = refuse to dispatch.
MCP_ALLOWLIST=linear,github

# Governed Web Search (P2: /search via You.com)
# Optional: when empty, /search uses the keyless free profile.
YDC_API_KEY=

# Encrypted provider keys (P5) — optional. When set, this Fernet key encrypts
# keys saved via POST /api/settings/keys. When blank, a key is generated once
# at DATA_DIR/.encryption_key (chmod 600). Env vars above always win when set.
APP_ENCRYPTION_KEY=

# Routine scheduler (P5) — in-process only, default OFF. Set to 1 to tick
# every 60s and run due routines through the normal governance path
# (mutations still pause for approval; never auto-approved).
ROUTINES_ENABLED=0

# Opt-in Computer Runtime (P4) — off by default (fake = inert deterministic stub).
# docker = Playwright image via hardened `docker run` (read-only rootfs, dropped
# caps, resource limits, per-assistant workspace); remote = external service stub.
COMPUTER_PROVIDER=fake
COMPUTER_DOCKER_IMAGE=indy-dots-computer:latest
COMPUTER_REMOTE_URL=
COMPUTER_REMOTE_TOKEN=
WORKSPACE_ROOT=/opt/data/workspaces
